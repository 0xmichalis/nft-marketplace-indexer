{
  "name": "nft-marketplace-indexer",
  "version": "0.1.0",
  "scripts": {
    "clean": "tsc --clean",
    "build": "tsc --build",
    "watch": "tsc --watch",
    "mocha": "NODE_OPTIONS='--import tsx' mocha test/**/*.ts",
    "test:unit": "NODE_OPTIONS='--import tsx' mocha test/*Tests.ts",
    "test:queries": "NODE_OPTIONS='--import tsx' mocha test/QueryIntegration.ts",
    "test:queries:verbose": "DEBUG=graphql-request NODE_OPTIONS='--import tsx' mocha test/QueryIntegration.ts",
    "codegen": "envio codegen",
    "start": "podman-compose up -d",
    "stop": "podman-compose down",
    "restart": "pnpm stop && pnpm start",
    "restart:clean": "pnpm stop -v && pnpm start",
    "test": "pnpm mocha",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "10.0.6",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "chai": "^5.1.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "husky": "^9.1.7",
    "mocha": "10.8.2",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.44.0"
  },
  "dependencies": {
    "envio": "3.14.0",
    "viem": "^2.37.7"
  },
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": "^0.16.8",
      "envio>express": "^4.22.3",
      "flatted@<3.4.2": "^3.4.2",
      "mocha>serialize-javascript": "^7.1.3",
      "viem>ws": "^8.21.0"
    }
  },
  "license": "Apache-2.0",
  "type": "module"
}
