{
  "compilerOptions": {
    "target": "es2022", //required for use with BigInt types
    "lib": ["es2022"],
    "types": ["node", "mocha"],
    "allowJs": true,
    "checkJs": false,
    "outDir": "build",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["src", "test", "envio-env.d.ts"]
}
